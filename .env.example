# App Store Connect API Key Configurations
# Fill in these values and rename this file to '.env'

# 1. The Key ID from your App Store Connect (e.g. '2X93XYZ87')
APP_STORE_CONNECT_API_KEY_ID="2X93XYZ87"

# 2. The Issuer ID from your App Store Connect (e.g. '5a782b12-9c10-4bf3-861c-813c9df6ef6e')
APP_STORE_CONNECT_API_KEY_ISSUER_ID="5a782b12-9c10-4bf3-861c-813c9df6ef6e"

# 3. Path to the downloaded AuthKey_xxxx.p8 file (e.g. './AuthKey_2X93XYZ87.p8')
# Or, if you prefer storing the key content directly in the environment variable, use KEY_CONTENT instead.
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH="./AuthKey_2X93XYZ87.p8"

# 4. Text content of the AuthKey_xxxx.p8 file (optional, alternative to FILEPATH)
# If using this, copy the entire file contents including the BEGIN and END lines.
APP_STORE_CONNECT_API_KEY_KEY_CONTENT=""
